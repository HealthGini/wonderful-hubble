# ==============================================================================
# GoodDeeds.space — Local & Production Environment Configuration
# Copy this file to `.env` (which is git-ignored) and uncomment ONE option below:
#   cp .env.example .env
# ==============================================================================

# Canonical base URL used for CTA buttons, email verification, password resets,
# and 1-click unsubscribe links inside outgoing emails:
PUBLIC_BASE_URL=http://localhost:8080

# Bind interface for server.py (defaults to 127.0.0.1 when Caddy sits in front):
HOST=127.0.0.1

# Session expiration in days (default: 30):
SESSION_TTL_DAYS=30

# Comma-separated email(s) automatically promoted to Site Admin:
# ADMIN_EMAIL=admin@gooddeeds.space

# Set SEED_DEMO=1 ONLY in local development to seed demo accounts & show Instant Demo Login buttons
# (leave unset or 0 in production!):
# SEED_DEMO=1

# Google OAuth 2.0 Web Client ID (required to accept Google Sign-In tokens):
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional comma-separated allowed CORS origins (defaults to own origin):
# CORS_ALLOWED_ORIGINS=https://gooddeeds.space,https://www.gooddeeds.space

# Sender identity displayed in recipient inboxes:
SMTP_FROM_NAME=GoodDeeds Community
SMTP_FROM_EMAIL=notifications@gooddeeds.space

# Set EMAIL_ASYNC=true in production so community broadcasts & invites dispatch
# in a background worker thread without adding latency to HTTP responses:
EMAIL_ASYNC=false

# ------------------------------------------------------------------------------
# OPTION 1A: Resend HTTPS REST API (Recommended for Production & Quick Testing)
# Free tier: 3,000 emails/mo (100/day) over HTTPS port 443 (never blocked).
# Tip: Before verifying gooddeeds.space DNS, set SMTP_FROM_EMAIL=onboarding@resend.dev
# to immediately test real delivery to your own Resend account email address!
# ------------------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_api_key_here
# SMTP_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# OPTION 1B: Brevo or Postmark HTTPS REST API (Port 443)
# ------------------------------------------------------------------------------
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-your_api_key_here

# EMAIL_PROVIDER=postmark
# POSTMARK_SERVER_TOKEN=your_postmark_server_token_here

# ------------------------------------------------------------------------------
# LOCAL TEST OPTION A: Zero-Account Local Catch-All SMTP Sink
# Run `python3 scripts/local_smtp_sink.py` in another terminal to inspect real
# TCP SMTP wire transmissions locally with zero external accounts!
# ------------------------------------------------------------------------------
# EMAIL_PROVIDER=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_TLS=false

# ------------------------------------------------------------------------------
# LOCAL TEST OPTION B: Personal Gmail / Google Workspace App Password (2-Min Setup)
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.name@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# SMTP_FROM_EMAIL=your.name@gmail.com

# ------------------------------------------------------------------------------
# PRODUCTION SMTP OPTION: Amazon SES / Resend SMTP / Postmark SMTP
# ------------------------------------------------------------------------------
# EMAIL_PROVIDER=smtp
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_ses_smtp_username
# SMTP_PASSWORD=your_ses_smtp_password
